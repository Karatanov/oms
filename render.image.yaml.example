# Reference settings for the EXISTING oms service. Replace the SHA placeholder
# with the tested 40-character master commit before configuring the service.
services:
  - type: web
    name: oms
    runtime: image
    plan: starter
    autoDeployTrigger: off
    healthCheckPath: /health
    image:
      url: ghcr.io/karatanov/oms:sha-REPLACE_WITH_TESTED_FULL_SHA
      creds:
        fromRegistryCreds:
          name: ghcr-oms
    disk:
      name: usif-uploads
      mountPath: /var/data
      sizeGB: 1
    envVars:
      - { key: OMS_BRAND, value: usif }
      - { key: OMS_PUBLIC_BASE_URL, value: "https://oms-3j46.onrender.com" }
      - { key: CORS_ALLOWED_HOST, value: "https://oms-3j46.onrender.com" }
      - { key: OMS_WEB_DIR, value: /opt/oms/web }
      - { key: OMS_UPLOAD_DIR, value: /var/data/uploads }
      - { key: DATABASE_DIALECT, value: mysql }
      - { key: DATABASE_URL, sync: false }
      - { key: DATABASE_USER, sync: false }
      - { key: DATABASE_PASSWORD, sync: false }
      - { key: OMS_JWT_SECRET, generateValue: true }
      - { key: PROCUREMENT_AUTO_REFRESH_ENABLED, value: "false" }
      - { key: SUBPROJECT_AUTO_REFRESH_ENABLED, value: "false" }
      - { key: PAYMENT_MONITORING_AUTO_REFRESH_ENABLED, value: "false" }
