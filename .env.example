# Copy this file to an untracked .env before a database-backed local or Compose run.
# Replace every placeholder and never commit .env.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-local-root-password
MYSQL_DATABASE=umitaf
DATABASE_URL=jdbc:mysql://localhost:3306/umitaf
DATABASE_USER=umitaf_user
DATABASE_PASSWORD=replace-with-a-unique-local-password
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2

# Optional runtime log level. INFO is the production-safe default.
OMS_LOG_LEVEL=INFO

# Required in persistent deployments. Use a random value of at least 32 characters.
OMS_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Docker Compose only: external host port for the integrated OMS service.
OMS_PORT=8080

# Base URL used in the locally queued account-activation message.
OMS_PUBLIC_BASE_URL=http://localhost:8080

# Optional: only for a separately deployed HTTPS frontend.
# CORS_ALLOWED_HOST=oms-frontend.onrender.com

# Optional paid Render disk mount; files are otherwise temporary on Render.
# OMS_UPLOAD_DIR=/var/data/uploads
