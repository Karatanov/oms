# Copy to /docker/oms/.env and set mode 0600. Do not commit the resulting file.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-strong-password
MYSQL_DATABASE=urp3
DATABASE_USER=urp3_user
DATABASE_PASSWORD=replace-with-a-unique-strong-password
OMS_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_POOL_MAX_SIZE=10
DATABASE_POOL_MIN_IDLE=2
OMS_LOG_LEVEL=INFO
OMS_IMAGE_TAG=latest

# Optional private procurement workbook. Copy docker-compose.google-drive.yml
# beside docker-compose.yml before enabling these settings (see documentation).
# COMPOSE_FILE=docker-compose.yml:docker-compose.google-drive.yml
# GOOGLE_OAUTH_CLIENT_FILE=/docker/secrets/oms-google-oauth-client.json
